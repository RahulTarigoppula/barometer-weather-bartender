{
  "name": "barometer",
  "private": true,
  "version": "1.0.0",
  "description": "Barometer: a 3D planet that opens on India. Weather first, then the drink it calls for, at your budget.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run --coverage",
    "test:wit": "vitest run src/wit",
    "test:e2e": "playwright test --grep-invert @live",
    "test:live": "playwright test --grep @live",
    "check:licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;MPL-2.0;Zlib;CC0-1.0;Unlicense;0BSD;CC-BY-4.0;OFL-1.1\" --excludePackages \"suncalc@2.1.1\"",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:menu": "node scripts/check-menu.mjs",
    "sample:voice": "tsx scripts/sample-voice.ts",
    "prep:geo": "node scripts/prep-geo.mjs",
    "prep:textures": "node scripts/prep-textures.mjs",
    "prep:icons": "node scripts/prep-icons.mjs",
    "test:all": "npm run check:menu && npm run test:unit && npm run check:licenses && npm run build && npm run check:bundle && npm run test:e2e"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "d3-geo": "^3.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "geokdbush": "^2.1.0",
    "kdbush": "^4.1.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "seedrandom": "^3.0.5",
    "suncalc": "^2.1.1",
    "three": "^0.186.1",
    "tracery-grammar": "^2.8.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/seedrandom": "^3.0.8",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "license-checker-rseidelsohn": "^4.4.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
